# Kilaubot Vercel environment variables
# DO NOT put real secrets in GitHub.

DIALOGFLOW_PROJECT_ID=kilaubot-gdtr
GOOGLE_CLIENT_EMAIL=your-service-account@kilaubot-gdtr.iam.gserviceaccount.com

# Paste the full private key value from the service account JSON.
# On Vercel it can be entered with the -----BEGIN PRIVATE KEY----- lines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
